---
import { url } from '../lib/site';
const path = Astro.url.pathname.replace(/\/$/, '');
const links = [
  { href: url('/'), label: 'Posts' },
  { href: url('/categories'), label: 'Categories' },
  { href: url('/about'), label: 'About' },
];
const indexUrl = url('/search-index.json');
---
<header class="site-header">
  <div class="container">
    <a class="logo" href={url('/')} aria-label="홈으로"><span class="prompt">~$</span>lejus<span class="cursor" aria-hidden="true"></span></a>
    <nav class="nav">
      {links.map((l) => (
        <a href={l.href} aria-current={path === l.href.replace(/\/$/, '') ? 'page' : undefined}>{l.label}</a>
      ))}
      <button class="nav-search" id="search-open" type="button" aria-label="검색 (단축키 /)" aria-haspopup="dialog">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        <span class="nav-search-label">검색</span>
        <kbd class="nav-search-kbd">/</kbd>
      </button>
      <button class="theme-toggle" id="theme-toggle" type="button" aria-label="테마 전환">
        <svg class="moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        <svg class="sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
      </button>
    </nav>
  </div>
</header>

<div class="search-modal" id="search-modal" hidden>
  <div class="search-modal-backdrop" data-close></div>
  <div class="search-modal-panel" role="dialog" aria-modal="true" aria-label="글 검색">
    <div class="search-modal-head">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
      <input id="search-modal-input" type="search" placeholder="제목·설명·태그·카테고리 검색…" autocomplete="off" spellcheck="false" aria-label="검색어" aria-controls="search-modal-results" />
      <button type="button" class="search-modal-close" data-close aria-label="닫기">Esc</button>
    </div>
    <p class="search-modal-status" id="search-modal-status" aria-live="polite"></p>
    <ul class="search-modal-results" id="search-modal-results"></ul>
  </div>
</div>

<script is:inline>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch {}
  });
</script>

<script is:inline define:vars={{ indexUrl }}>
  (() => {
    const modal = document.getElementById('search-modal');
    const input = document.getElementById('search-modal-input');
    const results = document.getElementById('search-modal-results');
    const status = document.getElementById('search-modal-status');
    if (!modal || !input) return;

    let posts = null;
    let active = -1;
    const esc = (s) => String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));

    async function ensureIndex() {
      if (posts) return;
      try { posts = await (await fetch(indexUrl)).json(); }
      catch { posts = []; status.textContent = '검색 인덱스를 불러오지 못했습니다.'; }
    }

    function render(q) {
      const query = q.trim().toLowerCase();
      let list = posts || [];
      if (query) {
        const terms = query.split(/\s+/).filter(Boolean);
        list = list.filter((p) => {
          const hay = (p.title + ' ' + p.description + ' ' + p.category + ' ' + (p.tags || []).join(' ')).toLowerCase();
          return terms.every((t) => hay.includes(t));
        });
      }
      list = list.slice(0, 20);
      active = list.length ? 0 : -1;
      status.textContent = query ? `“${q.trim()}” — ${list.length}개` : `전체 ${(posts || []).length}개 글 · 검색어를 입력하세요`;
      results.innerHTML = list.map((p, i) => `
        <li><a class="search-hit${i === 0 ? ' is-active' : ''}" href="${esc(p.url)}" data-i="${i}">
          <span class="search-hit-cat">${esc(p.category)}</span>
          <span class="search-hit-title">${esc(p.title)}</span>
          <span class="search-hit-date">${esc(p.date)}</span>
        </a></li>`).join('') || '<li class="search-hit-empty">일치하는 글이 없습니다.</li>';
    }

    function setActive(n) {
      const hits = [...results.querySelectorAll('.search-hit')];
      if (!hits.length) return;
      active = (n + hits.length) % hits.length;
      hits.forEach((h, i) => h.classList.toggle('is-active', i === active));
      hits[active].scrollIntoView({ block: 'nearest' });
    }

    async function open(initial) {
      modal.hidden = false;
      document.body.style.overflow = 'hidden';
      if (initial != null) input.value = initial;
      input.focus();
      input.select();
      status.textContent = '불러오는 중…';
      await ensureIndex();
      render(input.value);
    }
    function close() {
      modal.hidden = true;
      document.body.style.overflow = '';
    }

    document.getElementById('search-open')?.addEventListener('click', () => open());
    modal.querySelectorAll('[data-close]').forEach((el) => el.addEventListener('click', close));
    input.addEventListener('input', () => render(input.value));

    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') { e.preventDefault(); setActive(active + 1); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); setActive(active - 1); }
      else if (e.key === 'Enter') {
        const cur = results.querySelector('.search-hit.is-active');
        if (cur) { e.preventDefault(); location.href = cur.getAttribute('href'); }
      }
    });

    // 태그 칩 등 [data-search] 클릭 → 그 검색어로 모달 열기
    document.addEventListener('click', (e) => {
      const t = e.target.closest('[data-search]');
      if (t) { e.preventDefault(); open(t.getAttribute('data-search')); }
    });

    // 전역 단축키: '/' 또는 Ctrl/⌘+K 로 열기, Esc 로 닫기
    document.addEventListener('keydown', (e) => {
      const typing = /^(INPUT|TEXTAREA|SELECT)$/.test(document.activeElement?.tagName) || document.activeElement?.isContentEditable;
      if (e.key === 'Escape' && !modal.hidden) { close(); return; }
      if ((e.key === 'k' || e.key === 'K') && (e.metaKey || e.ctrlKey)) { e.preventDefault(); open(); return; }
      if (e.key === '/' && !typing && modal.hidden) { e.preventDefault(); open(); }
    });
  })();
</script>
