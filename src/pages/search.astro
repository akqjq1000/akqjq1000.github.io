---
import Base from '../layouts/Base.astro';
import { url } from '../lib/site';
---
<Base title="Search" description="제목·설명·태그·카테고리로 블로그 글을 검색합니다." noindex={true}>
  <section class="hero">
    <p class="eyebrow">$ grep -ri ./posts</p>
    <h1>Search</h1>
    <p>제목·설명·태그·카테고리로 글을 검색합니다.</p>
  </section>
  <div class="search">
    <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
    <input id="search-input" type="search" placeholder="검색어를 입력하세요…" autocomplete="off" spellcheck="false" aria-label="글 검색" />
  </div>
  <p id="search-status" class="search-status" aria-live="polite"></p>
  <ul id="search-results" class="post-list"></ul>
</Base>

<script is:inline define:vars={{ indexUrl: url('/search-index.json') }}>
  (async () => {
    const input = document.getElementById('search-input');
    const results = document.getElementById('search-results');
    const status = document.getElementById('search-status');
    let posts = [];
    try { posts = await (await fetch(indexUrl)).json(); } catch { status.textContent = '검색 인덱스를 불러오지 못했습니다.'; return; }

    const esc = (s) => String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));

    function render(q) {
      const query = q.trim().toLowerCase();
      let list = posts;
      if (query) {
        const terms = query.split(/\s+/).filter(Boolean);
        list = posts.filter((p) => {
          const hay = (p.title + ' ' + p.description + ' ' + p.category + ' ' + (p.tags || []).join(' ')).toLowerCase();
          return terms.every((t) => hay.includes(t));
        });
      }
      status.textContent = query ? `“${q.trim()}” — ${list.length}개 결과` : `전체 ${posts.length}개 글`;
      results.innerHTML = list.map((p) => `
        <li><a class="post-card" href="${esc(p.url)}">
          <div class="meta"><span class="badge">${esc(p.category)}</span><time>${esc(p.date)}</time></div>
          <h2>${esc(p.title)}</h2>
          <p>${esc(p.description)}</p>
        </a></li>`).join('') || '<li><p class="empty">일치하는 글이 없습니다.</p></li>';
    }

    const q0 = new URLSearchParams(location.search).get('q') || '';
    input.value = q0;
    render(q0);
    input.addEventListener('input', () => render(input.value));
    input.focus();
  })();
</script>
