---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Sidebar from '../../components/Sidebar.astro';
import { getPosts, slugifyTag, type Post } from '../../lib/posts';
import { url, formatDate, readingTime, SITE } from '../../lib/site';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => {
    const related = posts
      .filter((p) => p.id !== post.id && p.data.category === post.data.category)
      .slice(0, 4);
    return {
      params: { slug: post.id },
      props: { post, newer: posts[i - 1], older: posts[i + 1], related },
    };
  });
}

interface Props { post: Post; newer?: Post; older?: Post; related: Post[] }
const { post, newer, older, related } = Astro.props;
const { Content, headings } = await render(post);
const minutes = readingTime(post.body);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);

const postUrl = new URL(url(`/posts/${post.id}/`), Astro.site).href;
const published = post.data.date.toISOString();
const modified = (post.data.updated ?? post.data.date).toISOString();
const blogPostingLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: published,
  dateModified: modified,
  author: { '@type': 'Person', name: SITE.author, url: SITE.github },
  publisher: { '@type': 'Person', name: SITE.author },
  mainEntityOfPage: { '@type': 'WebPage', '@id': postUrl },
  url: postUrl,
  inLanguage: 'ko-KR',
  articleSection: post.data.category,
  ...(post.data.tags.length > 0 ? { keywords: post.data.tags.join(', ') } : {}),
};
---
<Base
  title={post.data.title}
  description={post.data.description}
  type="article"
  publishedTime={published}
  modifiedTime={modified}
  jsonLd={blogPostingLd}
>
  <div class="reading-progress" id="reading-progress" aria-hidden="true"></div>
  <article>
    <header class="post-header">
      <div class="meta">
        <a class="badge" href={url(`/categories/${slugifyTag(post.data.category)}/`)}>{post.data.category}</a>
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        <span>· {minutes} min read</span>
        {post.data.updated && <span>· 수정 {formatDate(post.data.updated)}</span>}
      </div>
      <h1>{post.data.title}</h1>
      <p class="desc">{post.data.description}</p>
      {post.data.tags.length > 0 && (
        <div class="tags">
          {post.data.tags.map((t) => <a class="tag" href={`${url('/search/')}?q=${encodeURIComponent(t)}`}>#{t}</a>)}
        </div>
      )}
    </header>
    <div class="prose">
      <Content />
    </div>
    <footer class="post-footer">
      {related.length > 0 && (
        <section class="related" aria-label="관련 글">
          <h2 class="section-title">같은 카테고리의 다른 글</h2>
          <ul class="related-list">
            {related.map((p) => (
              <li>
                <a href={url(`/posts/${p.id}/`)}>
                  <span class="related-title">{p.data.title}</span>
                  <span class="related-date">{formatDate(p.data.date)}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}
      <nav class="post-nav" aria-label="이전/다음 글">
        {older && <a class="prev" href={url(`/posts/${older.id}/`)}><small>← 이전 글</small>{older.data.title}</a>}
        {newer && <a class="next" href={url(`/posts/${newer.id}/`)}><small>다음 글 →</small>{newer.data.title}</a>}
      </nav>
    </footer>
  </article>
  {toc.length > 1 ? (
    <aside class="sidebar toc" slot="aside" aria-label="목차">
      <section>
        <h3>목차</h3>
        <ul>
          {toc.map((h) => (
            <li class={`toc-d${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>
          ))}
        </ul>
      </section>
    </aside>
  ) : <Sidebar slot="aside" />}
</Base>

<script is:inline>
  (() => {
    // 코드 블록: 언어 표시 + 복사 버튼
    document.querySelectorAll('.prose pre').forEach((pre) => {
      const wrap = document.createElement('div');
      wrap.className = 'code-block';
      pre.parentNode.insertBefore(wrap, pre);
      wrap.appendChild(pre);
      const lang = pre.dataset.language;
      if (lang && lang !== 'plaintext') {
        const label = document.createElement('span');
        label.className = 'code-lang';
        label.textContent = lang;
        wrap.appendChild(label);
      }
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'code-copy';
      btn.textContent = '복사';
      btn.setAttribute('aria-label', '코드 복사');
      btn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(pre.innerText.replace(/\n$/, ''));
          btn.textContent = '복사됨';
        } catch {
          btn.textContent = '실패';
        }
        setTimeout(() => { btn.textContent = '복사'; }, 1500);
      });
      wrap.appendChild(btn);
    });

    // 목차: 현재 읽는 위치 표시
    const links = [...document.querySelectorAll('.toc a')];
    if (!links.length || !('IntersectionObserver' in window)) return;
    const map = new Map(links.map((a) => [decodeURIComponent(a.hash.slice(1)), a]));
    const visible = new Set();
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => (e.isIntersecting ? visible.add(e.target.id) : visible.delete(e.target.id)));
      const heads = [...map.keys()].map((id) => document.getElementById(id)).filter(Boolean);
      const current = heads.find((h) => visible.has(h.id)) ??
        heads.filter((h) => h.getBoundingClientRect().top < 100).pop();
      links.forEach((a) => a.removeAttribute('aria-current'));
      if (current) map.get(current.id)?.setAttribute('aria-current', 'true');
    }, { rootMargin: '-80px 0px -60% 0px' });
    map.forEach((_, id) => { const el = document.getElementById(id); if (el) io.observe(el); });
  })();
</script>

<script is:inline>
  (() => {
    const bar = document.getElementById('reading-progress');
    if (!bar) return;
    const update = () => {
      const h = document.documentElement;
      const max = h.scrollHeight - h.clientHeight;
      const p = max > 0 ? Math.min(1, h.scrollTop / max) : 0;
      bar.style.transform = 'scaleX(' + p + ')';
    };
    update();
    addEventListener('scroll', update, { passive: true });
    addEventListener('resize', update, { passive: true });
  })();
</script>
